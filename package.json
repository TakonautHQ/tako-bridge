{
  "name": "@takonaut/tako-bridge",
  "version": "0.4.1",
  "description": "Tako Bridge for Pi — governed Takonaut work, repository verification, durable recovery, and human-reviewed delivery evidence.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/TakonautHQ/tako-bridge.git"
  },
  "homepage": "https://github.com/TakonautHQ/tako-bridge#readme",
  "bugs": {
    "url": "https://github.com/TakonautHQ/tako-bridge/issues"
  },
  "files": [
    "src",
    "bun.lock",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "keywords": [
    "pi-package",
    "takonaut",
    "tako-bridge",
    "agentic-delivery",
    "mcp"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.6",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "nanoid": "3.3.18",
    "qs": "6.16.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
